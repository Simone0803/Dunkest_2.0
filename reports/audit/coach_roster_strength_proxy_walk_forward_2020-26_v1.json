{
  "scope": "Historical team PDK output used as a lagged proxy for team/roster strength; training 2020-21 through 2023-24, validation 2024-25, final holdout 2025-26",
  "sources": {
    "team_logs": "data/processed/team_game_logs_2018-26_v1.parquet",
    "verified_pdk_player_game_training": "data/processed/dunkest_pdk_game_training_2020-26_v3.parquet",
    "baseline_forecasts": "reports/audit/coach_points_model_tuning_walk_forward_2018-26_v3.csv"
  },
  "feature_definition": "Sum verified official player-game PDK by NBA game/team; require >=7 matched players; use the mean of the prior five available team-game PDK sums (minimum three), centered against the historical league mean available before that date",
  "fit": {
    "method": "Ridge regression on team-game point residuals after the walk-forward baseline forecast",
    "alpha": 10.0,
    "training_seasons": [
      "2020-21",
      "2021-22",
      "2022-23",
      "2023-24"
    ],
    "training_team_game_rows": 6160,
    "coefficients": {
      "pdk_strength_delta": -0.01146804967348823,
      "opponent_pdk_strength_delta": 0.008199476141462728
    },
    "intercept": -1.1962139664447575,
    "minimum_players_per_team_game": 7,
    "minimum_prior_pdk_games": 3
  },
  "validation": {
